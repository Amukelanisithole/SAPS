@model Logic.Model.PagedResult<Database.Entities.PreliminaryReport>
@{
    ViewData["Title"] = "Reports Awaiting Review";
    long? statusId = ViewBag.StatusId;
    var statusOptions = new (long Id, string Name)[] {
        (EReportStatus.Submitted, "Submitted"),
        (EReportStatus.UnderReview, "Under Review"),
    };
}

<div class="saps-content-header">
    <h1 class="h3 mb-0">Reports Awaiting Review</h1>
    <div class="saps-breadcrumb">Home / Reports For Review</div>
</div>

<div class="card saps-card mb-3">
    <form method="get" class="p-3 d-flex gap-2 flex-wrap align-items-center">
        <div class="saps-field-group" style="max-width: 240px;">
            <i class="bi bi-funnel"></i>
            <select name="statusId">
                <option value="">All Statuses</option>
                @foreach (var opt in statusOptions)
                {
                    <option value="@opt.Id" selected="@(statusId == opt.Id ? "selected" : null)">@opt.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel"></i> Filter</button>
        @if (statusId != null)
        {
            <a asp-controller="Reports" asp-action="ForReview" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Clear</a>
        }
    </form>
</div>

@if (!Model.Items.Any())
{
    <div class="card saps-card">
        <div class="saps-empty-state">
            <i class="bi bi-inbox"></i>
            @(statusId == null ? "No preliminary reports are currently awaiting review." : "No reports match that status.")
        </div>
    </div>
}
else
{
    <div class="card saps-card">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Reference Number</th>
                        <th>Incident Type</th>
                        <th>Location</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model.Items)
                    {
                        <tr>
                            <td>@report.ReferenceNumber</td>
                            <td>@report.IncidentType</td>
                            <td>@report.IncidentLocation</td>
                            <td>@report.SubmissionTimestamp.ToLocalTime()</td>
                            <td><span class="badge @EReportStatus.GetBadgeClass(report.StatusId)">@EReportStatus.GetName(report.StatusId)</span></td>
                            <td>
                                <a asp-controller="Reports" asp-action="Details" asp-route-id="@report.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-clipboard-check"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pagination" model="@(new SAPS.Models.PaginationViewModel {
        Controller = "Reports", Action = "ForReview", Page = Model.Page, TotalPages = Model.TotalPages,
        RouteValues = statusId == null ? new() : new() { ["statusId"] = statusId.ToString()! }
    })" />
}
