@model Logic.Model.PagedResult<Database.Entities.User>
@{
    ViewData["Title"] = "Manage Users";
    long? roleId = ViewBag.RoleId;
    long? stationId = ViewBag.StationId;
    bool? isActive = ViewBag.IsActive;
    IEnumerable<Database.Entities.Station> stations = ViewBag.Stations;
    var roleOptions = new (long Id, string Name)[] {
        (ERole.Complainant, "Complainant"),
        (ERole.SapsOfficer, "SapsOfficer"),
        (ERole.StationCommander, "StationCommander"),
        (ERole.SystemAdministrator, "SystemAdministrator"),
    };
    var hasFilter = roleId != null || stationId != null || isActive != null;
}

<div class="saps-content-header">
    <h1 class="h3 mb-0">Manage Users</h1>
    <div class="saps-breadcrumb">Home / Users</div>
</div>

<p><a asp-controller="AdminUsers" asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Create User</a></p>

<div class="card saps-card mb-3">
    <form method="get" class="p-3 d-flex gap-2 flex-wrap align-items-center">
        <div class="saps-field-group" style="max-width: 220px;">
            <i class="bi bi-shield-check"></i>
            <select name="roleId">
                <option value="">All Roles</option>
                @foreach (var opt in roleOptions)
                {
                    <option value="@opt.Id" selected="@(roleId == opt.Id ? "selected" : null)">@opt.Name</option>
                }
            </select>
        </div>
        <div class="saps-field-group" style="max-width: 260px;">
            <i class="bi bi-building"></i>
            <select name="stationId">
                <option value="">All Stations</option>
                @foreach (var station in stations)
                {
                    <option value="@station.Id" selected="@(stationId == station.Id ? "selected" : null)">@station.StationName</option>
                }
            </select>
        </div>
        <div class="saps-field-group" style="max-width: 180px;">
            <i class="bi bi-toggle-on"></i>
            <select name="isActive">
                <option value="">Active + Inactive</option>
                <option value="true" selected="@(isActive == true ? "selected" : null)">Active only</option>
                <option value="false" selected="@(isActive == false ? "selected" : null)">Inactive only</option>
            </select>
        </div>
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel"></i> Filter</button>
        @if (hasFilter)
        {
            <a asp-controller="AdminUsers" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Clear</a>
        }
    </form>
</div>

@if (!Model.Items.Any())
{
    <div class="card saps-card">
        <div class="saps-empty-state">
            <i class="bi bi-people"></i>
            @(hasFilter ? "No users match those filters." : "No users found.")
        </div>
    </div>
}
else
{
    <div class="card saps-card">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Station</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Items)
                    {
                        <tr>
                            <td><i class="bi bi-person-circle text-muted me-1"></i> @user.FullName</td>
                            <td>@user.Email</td>
                            <td><span class="badge text-bg-info-subtle text-info-emphasis"><i class="bi bi-shield-check"></i> @ERole.GetName(user.RoleId)</span></td>
                            <td>@(user.NavStation?.StationName ?? "-")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-controller="AdminUsers" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    @if (user.IsActive)
                                    {
                                        <form asp-controller="AdminUsers" asp-action="Deactivate" asp-route-id="@user.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-person-x"></i> Deactivate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="AdminUsers" asp-action="Activate" asp-route-id="@user.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-person-check"></i> Activate
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    var routeValues = new Dictionary<string, string>();
    if (roleId != null) { routeValues["roleId"] = roleId.ToString()!; }
    if (stationId != null) { routeValues["stationId"] = stationId.ToString()!; }
    if (isActive != null) { routeValues["isActive"] = isActive.ToString()!.ToLowerInvariant(); }

    <partial name="_Pagination" model="@(new SAPS.Models.PaginationViewModel {
        Controller = "AdminUsers", Action = "Index", Page = Model.Page, TotalPages = Model.TotalPages, RouteValues = routeValues
    })" />
}
