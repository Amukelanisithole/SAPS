@model Logic.Model.PagedResult<Database.Entities.Docket>
@{
    ViewData["Title"] = "Dockets At My Station";
    long? statusId = ViewBag.StatusId;
    var statusOptions = new (long Id, string Name)[] {
        (EDocketStatus.Open, "Open"),
        (EDocketStatus.UnderInvestigation, "Under Investigation"),
        (EDocketStatus.Referred, "Referred"),
        (EDocketStatus.PendingClosure, "Pending Closure"),
        (EDocketStatus.Archived, "Archived"),
        (EDocketStatus.Closed, "Closed"),
    };
}

<div class="saps-content-header">
    <h1 class="h3 mb-0">Dockets At My Station</h1>
    <div class="saps-breadcrumb">Home / Dockets At My Station</div>
</div>

@{
    var incoming = (ViewBag.IncomingReferrals as IEnumerable<Database.Entities.Referral>)?.ToList() ?? new();
}
@if (incoming.Any())
{
    <div class="card saps-card mb-3 border-warning">
        <div class="saps-panel-header">
            <span><i class="bi bi-inbox"></i> Incoming Referrals</span>
            <span class="badge text-bg-warning">@incoming.Count awaiting acceptance</span>
        </div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Docket #</th>
                        <th>From</th>
                        <th>Incident</th>
                        <th>Reason</th>
                        <th>Requested</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var referral in incoming)
                    {
                        <tr>
                            <td>@referral.DocketId</td>
                            <td>@(referral.NavFromStation?.StationName ?? "-")</td>
                            <td>@(referral.NavDocket?.NavReport?.IncidentType ?? "-")</td>
                            <td class="text-truncate" style="max-width: 260px;" title="@referral.Reason">@referral.Reason</td>
                            <td>@referral.ReferralDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-controller="Dockets" asp-action="Details" asp-route-id="@referral.DocketId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card saps-card mb-3">
    <form method="get" class="p-3 d-flex gap-2 flex-wrap align-items-center">
        <div class="saps-field-group" style="max-width: 240px;">
            <i class="bi bi-funnel"></i>
            <select name="statusId">
                <option value="">All Statuses</option>
                @foreach (var opt in statusOptions)
                {
                    <option value="@opt.Id" selected="@(statusId == opt.Id ? "selected" : null)">@opt.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-funnel"></i> Filter</button>
        @if (statusId != null)
        {
            <a asp-controller="Dockets" asp-action="Station" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Clear</a>
        }
    </form>
</div>

@if (!Model.Items.Any())
{
    <div class="card saps-card">
        <div class="saps-empty-state">
            <i class="bi bi-folder2-open"></i>
            @(statusId == null ? "No dockets are currently held at your station." : "No dockets match that status.")
        </div>
    </div>
}
else
{
    <div class="card saps-card">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Docket #</th>
                        <th>CAS Number</th>
                        <th>Status</th>
                        <th>Opened</th>
                        <th>Last Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var docket in Model.Items)
                    {
                        <tr>
                            <td>@docket.Id</td>
                            <td>@(docket.CasNumber ?? "-")</td>
                            <td><span class="badge @EDocketStatus.GetBadgeClass(docket.StatusId)">@EDocketStatus.GetName(docket.StatusId)</span></td>
                            <td>@docket.OpenedDate.ToLocalTime()</td>
                            <td>@docket.LastUpdated.ToLocalTime()</td>
                            <td>
                                <a asp-controller="Dockets" asp-action="Details" asp-route-id="@docket.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a asp-controller="Dockets" asp-action="DownloadPdf" asp-route-id="@docket.Id" class="btn btn-sm btn-outline-primary" title="Download docket PDF">
                                    <i class="bi bi-file-earmark-arrow-down"></i> PDF
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pagination" model="@(new SAPS.Models.PaginationViewModel {
        Controller = "Dockets", Action = "Station", Page = Model.Page, TotalPages = Model.TotalPages,
        RouteValues = statusId == null ? new() : new() { ["statusId"] = statusId.ToString()! }
    })" />
}
