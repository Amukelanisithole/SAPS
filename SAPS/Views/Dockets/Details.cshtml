@model DocketDetailsViewModel
@{
    ViewData["Title"] = "Docket Details";
    var docket = Model.Docket;
}

<div class="saps-content-header">
    <h1 class="h3 mb-0">Docket #@docket.Id</h1>
    <div class="saps-breadcrumb">Home / Docket #@docket.Id</div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card saps-card">
            <div class="saps-panel-header">
                <span><i class="bi bi-folder2-open"></i> Docket Details</span>
                <span class="badge @EDocketStatus.GetBadgeClass(docket.StatusId)">@EDocketStatus.GetName(docket.StatusId)</span>
            </div>
            <dl class="row p-4 mb-0">
                <dt class="col-sm-3 text-muted">CAS Number</dt>
                <dd class="col-sm-9">@(docket.CasNumber ?? "Not yet assigned")</dd>

                <dt class="col-sm-3 text-muted">Opened</dt>
                <dd class="col-sm-9">@docket.OpenedDate.ToLocalTime()</dd>

                <dt class="col-sm-3 text-muted">Last Updated</dt>
                <dd class="col-sm-9">@docket.LastUpdated.ToLocalTime()</dd>
            </dl>
        </div>

        @if (Model.CanEscalate)
        {
            <p class="mt-4"><a asp-controller="Escalations" asp-action="Create" asp-route-docketId="@docket.Id" class="btn btn-warning"><i class="bi bi-exclamation-octagon-fill"></i> Escalate This Case</a></p>
        }

        <div class="card saps-card mt-4">
            <div class="saps-panel-header"><span><i class="bi bi-chat-dots"></i> Case Messages</span></div>
            <div class="p-4" style="max-height: 420px; overflow-y: auto;">
                @if (!Model.Comments.Any())
                {
                    <div class="saps-empty-state py-3">
                        <i class="bi bi-chat"></i>
                        No messages yet.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var comment in Model.Comments)
                        {
                            var isMine = comment.AuthorId == Model.ViewingUserId;
                            <div class="d-flex flex-column @(isMine ? "align-items-end" : "align-items-start")">
                                <div class="px-3 py-2 rounded-3 @(isMine ? "bg-primary-subtle text-primary-emphasis" : "bg-body-secondary")" style="max-width: 75%;">
                                    <div class="small fw-semibold mb-1">
                                        @comment.AuthorFullName <span class="text-muted fw-normal">(@comment.AuthorRoleName)</span>
                                    </div>
                                    <div style="white-space: pre-wrap;">@comment.Message</div>
                                </div>
                                <div class="text-muted" style="font-size:.7rem;">@comment.CreatedDate.ToLocalTime().ToString("dd MMM, HH:mm")</div>
                            </div>
                        }
                    </div>
                }
            </div>
            @if (Model.CanComment)
            {
                <form asp-controller="Dockets" asp-action="AddComment" asp-route-id="@docket.Id" method="post" class="saps-form-card-footer flex-column align-items-stretch gap-2">
                    <div class="saps-field-group">
                        <i class="bi bi-chat-square-text"></i>
                        <textarea asp-for="NewComment.Message" rows="2" placeholder="Write a message..." aria-label="Message"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary align-self-end"><i class="bi bi-send-fill"></i> Send</button>
                </form>
            }
            else
            {
                <div class="saps-form-card-footer">
                    <span class="text-muted small">Messaging is only available to the complainant and station staff on this case.</span>
                </div>
            }
        </div>

        @if (Model.CanUpdateStatus)
        {
            <div class="card saps-card mt-4">
                <div class="saps-form-card-header">
                    <h2 class="h5 mb-0"><i class="bi bi-arrow-repeat text-primary"></i> Update Status</h2>
                </div>
                <form asp-controller="Dockets" asp-action="UpdateStatus" asp-route-id="@docket.Id" method="post">
                    <div class="p-4">
                        <div class="saps-field-group">
                            <i class="bi bi-flag"></i>
                            <select asp-for="StatusUpdate.NewStatusId">
                                <option value="@EDocketStatus.Open">Open</option>
                                <option value="@EDocketStatus.UnderInvestigation">Under Investigation</option>
                                <option value="@EDocketStatus.Referred">Referred</option>
                                <option value="@EDocketStatus.Archived">Archived</option>
                                <option value="@EDocketStatus.Closed">Closed</option>
                            </select>
                        </div>
                    </div>
                    <div class="saps-form-card-footer">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Update Status</button>
                    </div>
                </form>
            </div>
        }

        @if (Model.CanRefer)
        {
            <div class="card saps-card mt-4">
                <div class="saps-form-card-header">
                    <h2 class="h5 mb-0"><i class="bi bi-signpost-split text-primary"></i> Refer To Another Station</h2>
                </div>
                <form asp-controller="Dockets" asp-action="Refer" asp-route-id="@docket.Id" method="post">
                    <div class="p-4">
                        <div class="mb-3">
                            <label asp-for="Referral.ToStationId" class="form-label small fw-semibold text-muted">Destination Station</label>
                            <div class="saps-field-group">
                                <i class="bi bi-building"></i>
                                <select asp-for="Referral.ToStationId">
                                    @foreach (var station in Model.AvailableStations)
                                    {
                                        <option value="@station.Id">@station.StationName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mb-0">
                            <label asp-for="Referral.Reason" class="form-label small fw-semibold text-muted"></label>
                            <div class="saps-field-group">
                                <i class="bi bi-chat-square-text"></i>
                                <textarea asp-for="Referral.Reason" rows="3" placeholder="Why is this docket being referred?"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="saps-form-card-footer">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-signpost-split"></i> Refer Docket</button>
                    </div>
                </form>
            </div>
        }

        <div class="card saps-card mt-4">
            <div class="saps-panel-header"><span><i class="bi bi-clock-history"></i> Referral History</span></div>
            @if (!Model.Referrals.Any())
            {
                <div class="saps-empty-state">
                    <i class="bi bi-signpost-split"></i>
                    This docket has not been referred.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var referral in Model.Referrals)
                            {
                                <tr>
                                    <td>@referral.ReferralDate.ToLocalTime()</td>
                                    <td>@referral.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card saps-card mt-4">
            <div class="saps-panel-header"><span><i class="bi bi-exclamation-octagon"></i> Escalations</span></div>
            @if (!Model.Escalations.Any())
            {
                <div class="saps-empty-state">
                    <i class="bi bi-exclamation-octagon"></i>
                    No escalations have been raised for this docket.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var escalation in Model.Escalations)
                            {
                                <tr>
                                    <td>@escalation.EscalationDate.ToLocalTime()</td>
                                    <td>@escalation.Description</td>
                                    <td><span class="badge @EEscalationStatus.GetBadgeClass(escalation.StatusId)">@EEscalationStatus.GetName(escalation.StatusId)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
