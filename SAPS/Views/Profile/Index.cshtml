@model SAPS.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="saps-content-header">
    <h1 class="h3 mb-0">My Profile</h1>
    <div class="saps-breadcrumb">Home / My Profile</div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card saps-card">
            <div class="saps-form-card-header">
                <h2 class="h5 mb-1"><i class="bi bi-person-badge text-primary"></i> Profile Details</h2>
                <p class="text-muted small mb-0">
                    Signed in as <strong>@User.GetRoleName()</strong>@(User.GetStationId() != null ? " · station-assigned" : "").
                    Changing your email will require re-verifying it.
                </p>
            </div>
            <form asp-controller="Profile" asp-action="UpdateProfile" method="post">
                <div class="p-4">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Profile.FullName" class="form-label small fw-semibold text-muted"></label>
                        <div class="saps-field-group">
                            <i class="bi bi-person"></i>
                            <input asp-for="Profile.FullName" placeholder="Full name" />
                        </div>
                        <span asp-validation-for="Profile.FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.Email" class="form-label small fw-semibold text-muted"></label>
                        <div class="saps-field-group">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Profile.Email" placeholder="name@saps.gov.za" />
                        </div>
                        <span asp-validation-for="Profile.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Profile.PhoneNumber" class="form-label small fw-semibold text-muted"></label>
                        <div class="saps-field-group">
                            <i class="bi bi-telephone"></i>
                            <input asp-for="Profile.PhoneNumber" placeholder="Phone number" maxlength="10" inputmode="numeric" autocomplete="off" data-digits-only />
                        </div>
                        <span asp-validation-for="Profile.PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>
                <div class="saps-form-card-footer">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card saps-card">
            <div class="saps-form-card-header">
                <h2 class="h5 mb-1"><i class="bi bi-shield-lock text-primary"></i> Change Password</h2>
                <p class="text-muted small mb-0">You'll need your current password to set a new one.</p>
            </div>
            <form asp-controller="Profile" asp-action="ChangePassword" method="post">
                <div class="p-4">
                    <div class="mb-3">
                        <label asp-for="ChangePassword.CurrentPassword" class="form-label small fw-semibold text-muted"></label>
                        <div class="saps-field-group">
                            <i class="bi bi-lock"></i>
                            <input asp-for="ChangePassword.CurrentPassword" type="password" autocomplete="current-password" placeholder="Current password" />
                            <button type="button" class="saps-toggle-password" data-target="ChangePassword_CurrentPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ChangePassword.NewPassword" class="form-label small fw-semibold text-muted"></label>
                        <div class="saps-field-group">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="ChangePassword.NewPassword" type="password" autocomplete="new-password" placeholder="New password" data-strength-meter />
                            <button type="button" class="saps-toggle-password" data-target="ChangePassword_NewPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="ChangePassword.NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ChangePassword.ConfirmNewPassword" class="form-label small fw-semibold text-muted"></label>
                        <div class="saps-field-group">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="ChangePassword.ConfirmNewPassword" type="password" autocomplete="new-password" placeholder="Confirm new password" />
                            <button type="button" class="saps-toggle-password" data-target="ChangePassword_ConfirmNewPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="ChangePassword.ConfirmNewPassword" class="text-danger small"></span>
                    </div>
                </div>
                <div class="saps-form-card-footer">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-shield-lock"></i> Change Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
