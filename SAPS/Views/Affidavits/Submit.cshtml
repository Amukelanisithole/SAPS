@model Logic.DTO.AffidavitDTO
@{
    ViewData["Title"] = "Submit an Affidavit";
}

<div class="saps-content-header">
    <h1 class="h3 mb-0">Submit an Affidavit / Statement</h1>
    <div class="saps-breadcrumb">Home / Submit Affidavit</div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card saps-card">
            <div class="saps-form-card-header">
                <h2 class="h5 mb-1"><i class="bi bi-file-earmark-check-fill text-primary"></i> Deponent Details</h2>
                <p class="text-muted small mb-0">This is the same statement you would otherwise complete on paper in front of a Commissioner of Oaths. It is routed to your nearest station, where a SAPS officer will certify it electronically.</p>
            </div>

            <form asp-controller="Affidavits" asp-action="Submit" method="post" enctype="multipart/form-data" id="submitAffidavitForm">
                <div class="p-4">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="FullName" class="form-label small fw-semibold text-muted"></label>
                            <div class="saps-field-group">
                                <i class="bi bi-person"></i>
                                <input asp-for="FullName" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Age" class="form-label small fw-semibold text-muted"></label>
                            <div class="saps-field-group">
                                <i class="bi bi-calendar3"></i>
                                <input asp-for="Age" type="number" min="1" max="120" />
                            </div>
                            <span asp-validation-for="Age" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdNumber" class="form-label small fw-semibold text-muted"></label>
                        <div class="saps-field-group">
                            <i class="bi bi-person-vcard"></i>
                            <input asp-for="IdNumber" maxlength="13" inputmode="numeric" autocomplete="off" data-digits-only />
                        </div>
                        <span asp-validation-for="IdNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 position-relative">
                        <label asp-for="WorkingAddress" class="form-label small fw-semibold text-muted"></label>
                        <div class="saps-field-group">
                            <i class="bi bi-geo-alt"></i>
                            <input asp-for="WorkingAddress" autocomplete="off" placeholder="Start typing an address&hellip;" />
                        </div>
                        <ul class="list-group saps-address-suggestions" id="addressSuggestions" style="display:none;"></ul>
                        <span asp-validation-for="WorkingAddress" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="TelWork" class="form-label small fw-semibold text-muted"></label>
                            <div class="saps-field-group">
                                <i class="bi bi-telephone"></i>
                                <input asp-for="TelWork" maxlength="10" inputmode="numeric" autocomplete="off" data-digits-only />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TelHome" class="form-label small fw-semibold text-muted"></label>
                            <div class="saps-field-group">
                                <i class="bi bi-telephone"></i>
                                <input asp-for="TelHome" maxlength="10" inputmode="numeric" autocomplete="off" data-digits-only />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TelCell" class="form-label small fw-semibold text-muted"></label>
                            <div class="saps-field-group">
                                <i class="bi bi-phone"></i>
                                <input asp-for="TelCell" maxlength="10" inputmode="numeric" autocomplete="off" data-digits-only />
                            </div>
                            <span asp-validation-for="TelCell" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DeclarationText" class="form-label small fw-semibold text-muted"></label>
                        <div class="saps-field-group">
                            <i class="bi bi-card-text"></i>
                            <textarea asp-for="DeclarationText" rows="6" placeholder="Declare under oath / confirm the facts of your statement here"></textarea>
                        </div>
                        <span asp-validation-for="DeclarationText" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-semibold text-muted">Do you object to taking the prescribed oath? <span class="text-danger">*</span></label>
                        <div class="d-flex flex-wrap gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="ObjectionToOath" id="ObjectionToOath_No" value="false" />
                                <label class="form-check-label small" for="ObjectionToOath_No">No, I have no objection</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="ObjectionToOath" id="ObjectionToOath_Yes" value="true" />
                                <label class="form-check-label small" for="ObjectionToOath_Yes">Yes, I object</label>
                            </div>
                        </div>
                        <span asp-validation-for="ObjectionToOath" class="text-danger small"></span>
                    </div>

                    <input asp-for="Latitude" type="hidden" id="latInput" />
                    <input asp-for="Longitude" type="hidden" id="lngInput" />
                </div>

                <div class="saps-form-card-footer">
                    <button type="submit" class="btn btn-primary" id="submitAffidavitBtn" disabled><i class="bi bi-send-fill"></i> Submit Affidavit</button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card saps-card mb-4">
            <div class="saps-panel-header"><span>Confirm Your Identity</span></div>
            <div class="p-3">
                <p class="text-muted small">Take a live photo to confirm this affidavit is being submitted by you. Your face must be visible in frame before a photo can be captured.</p>
                <div class="ratio ratio-4x3 bg-dark rounded mb-2" id="cameraFrame">
                    <video id="cameraVideo" autoplay playsinline muted class="rounded" style="object-fit:cover;"></video>
                    <img id="capturedPreview" class="rounded" style="object-fit:cover; display:none;" />
                </div>
                <canvas id="captureCanvas" style="display:none;"></canvas>
                <div id="faceStatus" class="small text-muted mb-2" style="display:none;"></div>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="enableCameraBtn"><i class="bi bi-camera"></i> Enable Camera</button>
                    <button type="button" class="btn btn-primary btn-sm" id="capturePhotoBtn" style="display:none;" disabled><i class="bi bi-camera-fill"></i> Capture Photo</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="retakePhotoBtn" style="display:none;"><i class="bi bi-arrow-repeat"></i> Retake</button>
                </div>
                <div id="cameraError" class="alert alert-warning small mt-2 mb-0" style="display:none;"></div>
                <input type="file" name="verificationPhoto" id="verificationPhotoInput" accept="image/jpeg" style="display:none;" form="submitAffidavitForm" />
            </div>
        </div>

        <div class="card saps-card mb-4">
            <div class="saps-panel-header"><span>ID Document</span></div>
            <div class="p-3">
                <p class="text-muted small">Attach a photo or scan of your ID document (book/card) to support your identity verification.</p>
                <div class="saps-field-group">
                    <i class="bi bi-person-vcard"></i>
                    <input type="file" name="idDocument" id="idDocumentInput" accept="image/jpeg,image/png,application/pdf" form="submitAffidavitForm" required />
                </div>
            </div>
        </div>

        <div class="card saps-card">
            <div class="saps-panel-header"><span>Nearest Station</span></div>
            <div class="p-3">
                <div id="locationStatus" class="d-flex align-items-center gap-2">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="small text-muted">Detecting your location&hellip;</span>
                </div>
                <p class="text-muted small mt-3 mb-0">Your affidavit is automatically routed to the SAPS station nearest your current location. Location access is required to submit.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script src="~/lib/face-api/face-api.min.js"></script>
    <script>
        function onLocationSuccess(position) {
            document.getElementById('latInput').value = position.coords.latitude;
            document.getElementById('lngInput').value = position.coords.longitude;
            document.getElementById('locationStatus').innerHTML =
                '<i class="bi bi-check-circle-fill text-success"></i> <span class="small text-muted">Location detected.</span>';
            updateSubmitState();
        }

        function onLocationError() {
            document.getElementById('locationStatus').innerHTML =
                '<div class="alert alert-warning small mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Location access was denied or is unavailable. ' +
                'Please enable location access and <button type="button" class="btn btn-sm btn-link p-0 align-baseline" onclick="requestLocation()">try again</button>.</div>';
        }

        function requestLocation() {
            if (!navigator.geolocation) {
                onLocationError();
                return;
            }
            navigator.geolocation.getCurrentPosition(onLocationSuccess, onLocationError, { enableHighAccuracy: true, timeout: 10000 });
        }

        let cameraStream = null;
        let faceDetectionTimer = null;
        let faceDetectionModelsReady = false;
        let faceDetectionAvailable = true; // false only if the models fail to load — degrades to allowing capture unguarded
        let faceCurrentlyDetected = false;

        function updateSubmitState() {
            const hasLocation = !!document.getElementById('latInput').value;
            const hasPhoto = document.getElementById('verificationPhotoInput').files.length > 0;
            const hasIdDocument = document.getElementById('idDocumentInput').files.length > 0;
            document.getElementById('submitAffidavitBtn').disabled = !(hasLocation && hasPhoto && hasIdDocument);
        }

        // Loaded lazily (only once a camera is actually opened) so a visitor
        // who never gets that far never pays for the model download.
        async function loadFaceDetectionModels() {
            if (faceDetectionModelsReady || !faceDetectionAvailable) return;
            try {
                await faceapi.nets.tinyFaceDetector.loadFromUri('/models/tiny_face_detector');
                faceDetectionModelsReady = true;
            } catch (e) {
                // No network access to the model, or the browser can't run it — fall
                // back to allowing capture without the face check rather than
                // blocking submission entirely over a best-effort safeguard.
                faceDetectionAvailable = false;
            }
        }

        function setFaceStatus(state) {
            const statusEl = document.getElementById('faceStatus');
            const captureBtn = document.getElementById('capturePhotoBtn');
            statusEl.style.display = 'block';
            if (state === 'loading') {
                statusEl.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Loading face detection&hellip;';
                captureBtn.disabled = true;
            } else if (state === 'detected') {
                statusEl.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i> Face detected — you can take the photo.';
                captureBtn.disabled = false;
            } else if (state === 'unavailable') {
                statusEl.style.display = 'none';
                captureBtn.disabled = false;
            } else {
                statusEl.innerHTML = '<i class="bi bi-exclamation-circle text-warning"></i> Position your face in the frame.';
                captureBtn.disabled = true;
            }
        }

        function startFaceDetectionLoop() {
            const video = document.getElementById('cameraVideo');
            setFaceStatus('loading');

            faceDetectionTimer = setInterval(async () => {
                if (!faceDetectionAvailable) {
                    clearInterval(faceDetectionTimer);
                    faceDetectionTimer = null;
                    setFaceStatus('unavailable');
                    return;
                }
                if (!faceDetectionModelsReady || video.readyState < 2 || video.paused) return;

                try {
                    const result = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions({ inputSize: 224, scoreThreshold: 0.5 }));
                    faceCurrentlyDetected = !!result;
                } catch (e) {
                    faceDetectionAvailable = false;
                    faceCurrentlyDetected = false;
                    return;
                }
                setFaceStatus(faceCurrentlyDetected ? 'detected' : 'searching');
            }, 400);
        }

        function stopFaceDetectionLoop() {
            if (faceDetectionTimer) {
                clearInterval(faceDetectionTimer);
                faceDetectionTimer = null;
            }
            faceCurrentlyDetected = false;
            document.getElementById('faceStatus').style.display = 'none';
        }

        async function enableCamera() {
            const errorEl = document.getElementById('cameraError');
            errorEl.style.display = 'none';
            try {
                cameraStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
                const video = document.getElementById('cameraVideo');
                video.srcObject = cameraStream;
                video.style.display = 'block';
                document.getElementById('capturedPreview').style.display = 'none';
                document.getElementById('enableCameraBtn').style.display = 'none';
                document.getElementById('capturePhotoBtn').style.display = 'block';
                document.getElementById('capturePhotoBtn').disabled = true;
                document.getElementById('retakePhotoBtn').style.display = 'none';

                await loadFaceDetectionModels();
                startFaceDetectionLoop();
            } catch (e) {
                errorEl.textContent = 'Could not access your camera. Please allow camera access and try again.';
                errorEl.style.display = 'block';
            }
        }

        function stopCameraStream() {
            if (cameraStream) {
                cameraStream.getTracks().forEach(t => t.stop());
                cameraStream = null;
            }
            stopFaceDetectionLoop();
        }

        function capturePhoto() {
            // Belt-and-suspenders: the button is disabled unless a face is
            // currently detected, but a face detection failure (see
            // loadFaceDetectionModels/startFaceDetectionLoop) re-enables it
            // deliberately, so this only actually blocks when detection is
            // available and simply hasn't found a face yet.
            if (faceDetectionAvailable && faceDetectionModelsReady && !faceCurrentlyDetected) return;

            const video = document.getElementById('cameraVideo');
            const canvas = document.getElementById('captureCanvas');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);

            canvas.toBlob(blob => {
                const file = new File([blob], 'verification.jpg', { type: 'image/jpeg' });
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                document.getElementById('verificationPhotoInput').files = dataTransfer.files;

                const preview = document.getElementById('capturedPreview');
                preview.src = URL.createObjectURL(blob);
                preview.style.display = 'block';
                video.style.display = 'none';

                stopCameraStream();
                document.getElementById('capturePhotoBtn').style.display = 'none';
                document.getElementById('retakePhotoBtn').style.display = 'block';
                updateSubmitState();
            }, 'image/jpeg', 0.9);
        }

        function retakePhoto() {
            document.getElementById('verificationPhotoInput').value = '';
            document.getElementById('capturedPreview').style.display = 'none';
            document.getElementById('retakePhotoBtn').style.display = 'none';
            document.getElementById('enableCameraBtn').style.display = 'block';
            updateSubmitState();
        }

        document.getElementById('enableCameraBtn').addEventListener('click', enableCamera);
        document.getElementById('capturePhotoBtn').addEventListener('click', capturePhoto);
        document.getElementById('retakePhotoBtn').addEventListener('click', retakePhoto);
        document.getElementById('idDocumentInput').addEventListener('change', updateSubmitState);
        window.addEventListener('beforeunload', stopCameraStream);

        // Working-address autocomplete, backed by the same free OpenStreetMap
        // Nominatim search AdminStations/Create already uses for "Locate on
        // Map" — debounced and aborts any in-flight lookup so a fast typist
        // never has an old, slower response overwrite a newer one.
        (function () {
            const input = document.getElementById('WorkingAddress');
            const list = document.getElementById('addressSuggestions');
            let debounceTimer = null;
            let abortController = null;
            let activeIndex = -1;

            function hideSuggestions() {
                list.style.display = 'none';
                list.innerHTML = '';
                activeIndex = -1;
            }

            // A query like "297 King" often only resolves to the road "King" —
            // OpenStreetMap's address-point coverage (individual house numbers)
            // is patchy in many South African areas, so Nominatim quietly drops
            // any token it can't match rather than failing the whole search.
            // Re-attach the door number the user actually typed whenever the
            // match doesn't already carry one, so the field never silently loses
            // it — the user knows their own street number better than OSM does.
            function extractLeadingHouseNumber(query) {
                const match = query.trim().match(/^(\d+[a-zA-Z]?)\s+/);
                return match ? match[1] : null;
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            // Nominatim's raw display_name strings every administrative level
            // (ward, municipality, district, province, postcode, country) into
            // one long line, which is accurate but unreadable. Build a short
            // "<number> <street>" / "<suburb>, <town>" pair instead — the level
            // of detail a user actually needs to recognize their own address —
            // falling back to display_name only when there isn't enough
            // structured data to build that (e.g. an administrative-area match).
            function labelFor(result, typedQuery) {
                const addr = result.address || {};
                const road = addr.road || addr.pedestrian || addr.footway || result.name;
                if (!road) return { primary: result.display_name, secondary: '' };

                const houseNumber = addr.house_number || extractLeadingHouseNumber(typedQuery);
                const suburb = addr.suburb || addr.neighbourhood || addr.quarter;
                const town = addr.town || addr.city || addr.village || addr.municipality;

                return {
                    primary: houseNumber ? `${houseNumber} ${road}` : road,
                    secondary: [suburb, town].filter(Boolean).join(', ')
                };
            }

            // Google-style suggestion rows: a pin icon, the matched street in
            // bold, and the broader area (suburb/town) trailing in muted text —
            // the same visual hierarchy as Google Maps' own search suggestions.
            function renderSuggestions(results, typedQuery) {
                list.innerHTML = '';
                if (results.length === 0) {
                    hideSuggestions();
                    return;
                }

                results.forEach((result) => {
                    const { primary, secondary } = labelFor(result, typedQuery);
                    const fullLabel = [primary, secondary].filter(Boolean).join(', ');

                    const item = document.createElement('li');
                    item.className = 'list-group-item d-flex align-items-start gap-2';
                    item.dataset.value = fullLabel;
                    item.innerHTML = `<i class="bi bi-geo-alt-fill text-muted mt-1"></i>` +
                        `<span><strong>${escapeHtml(primary)}</strong>${secondary ? `, <span class="text-muted">${escapeHtml(secondary)}</span>` : ''}</span>`;
                    item.addEventListener('mousedown', (e) => {
                        e.preventDefault(); // keep focus so blur doesn't hide the list first
                        selectSuggestion(fullLabel);
                    });
                    list.appendChild(item);
                });
                activeIndex = -1;
                list.style.display = 'block';
            }

            function selectSuggestion(label) {
                input.value = label;
                hideSuggestions();
            }

            function moveActive(delta) {
                const items = list.querySelectorAll('.list-group-item');
                if (items.length === 0) return;
                items[activeIndex]?.classList.remove('active');
                activeIndex = (activeIndex + delta + items.length) % items.length;
                items[activeIndex].classList.add('active');
                items[activeIndex].scrollIntoView({ block: 'nearest' });
            }

            async function fetchSuggestions(query) {
                if (abortController) abortController.abort();
                abortController = new AbortController();

                try {
                    const url = `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&limit=5&countrycodes=za&q=${encodeURIComponent(query)}`;
                    const res = await fetch(url, { signal: abortController.signal });
                    if (!res.ok) return;
                    const results = await res.json();
                    renderSuggestions(results, query);
                } catch (e) {
                    // Aborted (a newer keystroke superseded this lookup) or offline —
                    // either way there's nothing useful to show for this query.
                }
            }

            input.addEventListener('input', () => {
                const query = input.value.trim();
                clearTimeout(debounceTimer);
                if (query.length < 3) {
                    hideSuggestions();
                    return;
                }
                debounceTimer = setTimeout(() => fetchSuggestions(query), 400);
            });

            input.addEventListener('keydown', (e) => {
                if (list.style.display === 'none') return;
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    moveActive(1);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    moveActive(-1);
                } else if (e.key === 'Enter' && activeIndex >= 0) {
                    e.preventDefault();
                    selectSuggestion(list.querySelectorAll('.list-group-item')[activeIndex].dataset.value);
                } else if (e.key === 'Escape') {
                    hideSuggestions();
                }
            });

            input.addEventListener('blur', hideSuggestions);
        })();

        document.addEventListener('DOMContentLoaded', requestLocation);
    </script>
}
