@using Logic.BusinessLogicInterface
@inject INotificationLogic NotificationLogic
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    bool IsActive(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase));
    var initials = string.Concat(User.GetFullName().Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpperInvariant();
    if (initials.Length > 2) initials = initials[..2];

    var myNotifications = (await NotificationLogic.GetMineAsync(User.GetUserId())).ToList();
    var unreadNotificationCount = myNotifications.Count(n => !n.ReadStatus);
    var recentNotifications = myNotifications.Take(5).ToList();

    // Unverified accounts are blocked from the actual page content everywhere
    // this layout is used — not just nagged with a dismissible modal on top
    // of it — except Emergency, which must never be gated behind anything,
    // verification included, and Profile, so someone who mistyped their
    // email at registration has a way to fix it (and isn't otherwise
    // permanently stuck, since fixing it is the one thing that unblocks
    // the gate) instead of just being told to check an inbox they can't reach.
    var isEmergencyPage = string.Equals(currentController, "Emergency", StringComparison.OrdinalIgnoreCase);
    var isProfilePage = string.Equals(currentController, "Profile", StringComparison.OrdinalIgnoreCase);
    var requiresEmailVerification = !User.GetEmailVerified() && !isEmergencyPage && !isProfilePage;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        // Set before any CSS paints, so there's no flash of the wrong theme
        // or the wrong sidebar width.
        (function () {
            var saved = null;
            try { saved = localStorage.getItem('saps-theme'); } catch (e) { /* private browsing, etc. */ }
            document.documentElement.setAttribute('data-bs-theme', saved === 'light' ? 'light' : 'dark');

            var sidebarCollapsed = false;
            try { sidebarCollapsed = localStorage.getItem('saps-sidebar-collapsed') === 'true'; } catch (e) { /* private browsing, etc. */ }
            if (sidebarCollapsed) {
                document.documentElement.classList.add('saps-sidebar-collapsed');
            }
        })();
    </script>
    <title>@ViewData["Title"] - SAPS Crime Pre-Reporting</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SAPS.styles.css" asp-append-version="true" />
</head>
<body class="saps-app-body">
    @await Html.PartialAsync("_GlobalSpinner")
    <div class="d-flex align-items-stretch">
        <div class="offcanvas-lg offcanvas-start saps-sidebar" tabindex="-1" id="sapsSidebar">
            <div class="offcanvas-header d-lg-none px-3">
                <span class="text-white fw-semibold">Menu</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sapsSidebar" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <div class="saps-sidebar-brand d-flex align-items-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none">
                        <img src="~/branding/saps-logo.png" alt="SAPS" class="saps-navbar-logo" />
                        <span class="text-white fw-bold text-truncate">SAPS Portal</span>
                    </a>
                    <button type="button" class="saps-sidebar-toggle" data-sidebar-toggle aria-label="Collapse sidebar" title="Collapse sidebar">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                </div>

                <ul class="nav flex-column saps-sidebar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="saps-sidebar-link @(IsActive("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index" title="Dashboard">
                            <i class="bi bi-speedometer2"></i> <span class="saps-sidebar-link-text">Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="saps-sidebar-link @(IsActive("NotificationsPage") ? "active" : "")" asp-controller="NotificationsPage" asp-action="Index" title="Notifications">
                            <i class="bi bi-bell"></i> <span class="saps-sidebar-link-text">Notifications</span>
                        </a>
                    </li>

                    @switch (User.GetRoleName())
                    {
                        case "Complainant":
                            <li class="saps-sidebar-heading">My Case</li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Reports", "Submit") ? "active" : "")" asp-controller="Reports" asp-action="Submit" title="Submit Report">
                                    <i class="bi bi-file-earmark-plus"></i> <span class="saps-sidebar-link-text">Submit Report</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Reports", "Mine") ? "active" : "")" asp-controller="Reports" asp-action="Mine" title="My Reports">
                                    <i class="bi bi-journal-text"></i> <span class="saps-sidebar-link-text">My Reports</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Dockets", "Mine") ? "active" : "")" asp-controller="Dockets" asp-action="Mine" title="My Dockets">
                                    <i class="bi bi-folder2-open"></i> <span class="saps-sidebar-link-text">My Dockets</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Escalations", "Mine") ? "active" : "")" asp-controller="Escalations" asp-action="Mine" title="My Escalations">
                                    <i class="bi bi-exclamation-octagon"></i> <span class="saps-sidebar-link-text">My Escalations</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Affidavits", "Submit") ? "active" : "")" asp-controller="Affidavits" asp-action="Submit" title="Submit Affidavit">
                                    <i class="bi bi-file-earmark-check"></i> <span class="saps-sidebar-link-text">Submit Affidavit</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Affidavits", "Mine") ? "active" : "")" asp-controller="Affidavits" asp-action="Mine" title="My Affidavits">
                                    <i class="bi bi-journal-check"></i> <span class="saps-sidebar-link-text">My Affidavits</span>
                                </a>
                            </li>
                            break;
                        case "SapsOfficer":
                            <li class="saps-sidebar-heading">Case Work</li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Reports", "ForReview") ? "active" : "")" asp-controller="Reports" asp-action="ForReview" title="Reports For Review">
                                    <i class="bi bi-inbox"></i> <span class="saps-sidebar-link-text">Reports For Review</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Dockets", "Station") ? "active" : "")" asp-controller="Dockets" asp-action="Station" title="Dockets At My Station">
                                    <i class="bi bi-geo-alt"></i> <span class="saps-sidebar-link-text">Dockets At My Station</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Affidavits", "ForReview") ? "active" : "")" asp-controller="Affidavits" asp-action="ForReview" title="Affidavits For Review">
                                    <i class="bi bi-file-earmark-check"></i> <span class="saps-sidebar-link-text">Affidavits For Review</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link text-danger @(IsActive("Emergency", "ForStation") ? "active" : "")" asp-controller="Emergency" asp-action="ForStation" title="Emergency Alerts">
                                    <i class="bi bi-broadcast"></i> <span class="saps-sidebar-link-text">Emergency Alerts</span>
                                </a>
                            </li>
                            break;
                        case "StationCommander":
                            <li class="saps-sidebar-heading">Station Oversight</li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Dockets", "Station") ? "active" : "")" asp-controller="Dockets" asp-action="Station" title="Dockets At My Station">
                                    <i class="bi bi-geo-alt"></i> <span class="saps-sidebar-link-text">Dockets At My Station</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Escalations", "Station") ? "active" : "")" asp-controller="Escalations" asp-action="Station" title="Escalations At My Station">
                                    <i class="bi bi-exclamation-octagon"></i> <span class="saps-sidebar-link-text">Escalations At My Station</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("Affidavits", "ForReview") ? "active" : "")" asp-controller="Affidavits" asp-action="ForReview" title="Affidavits For Review">
                                    <i class="bi bi-file-earmark-check"></i> <span class="saps-sidebar-link-text">Affidavits For Review</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link text-danger @(IsActive("Emergency", "ForStation") ? "active" : "")" asp-controller="Emergency" asp-action="ForStation" title="Emergency Alerts">
                                    <i class="bi bi-broadcast"></i> <span class="saps-sidebar-link-text">Emergency Alerts</span>
                                </a>
                            </li>
                            break;
                        case "SystemAdministrator":
                            <li class="saps-sidebar-heading">Administration</li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("AdminUsers") ? "active" : "")" asp-controller="AdminUsers" asp-action="Index" title="Users">
                                    <i class="bi bi-people"></i> <span class="saps-sidebar-link-text">Users</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("AdminStations") ? "active" : "")" asp-controller="AdminStations" asp-action="Index" title="Stations">
                                    <i class="bi bi-building"></i> <span class="saps-sidebar-link-text">Stations</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("AdminAffidavits") ? "active" : "")" asp-controller="AdminAffidavits" asp-action="Index" title="Affidavits">
                                    <i class="bi bi-file-earmark-check"></i> <span class="saps-sidebar-link-text">Affidavits</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link text-danger @(IsActive("AdminEmergencyAlerts") ? "active" : "")" asp-controller="AdminEmergencyAlerts" asp-action="Index" title="Emergency Alerts">
                                    <i class="bi bi-broadcast"></i> <span class="saps-sidebar-link-text">Emergency Alerts</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("AdminAuditLog") ? "active" : "")" asp-controller="AdminAuditLog" asp-action="Index" title="Audit Logs">
                                    <i class="bi bi-clock-history"></i> <span class="saps-sidebar-link-text">Audit Logs</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="saps-sidebar-link @(IsActive("AdminReports") ? "active" : "")" asp-controller="AdminReports" asp-action="Index" title="Reports & Exports">
                                    <i class="bi bi-file-earmark-bar-graph"></i> <span class="saps-sidebar-link-text">Reports &amp; Exports</span>
                                </a>
                            </li>
                            break;
                    }
                </ul>
            </div>
        </div>

        <div class="flex-grow-1 saps-main">
            <nav class="navbar saps-topbar border-bottom px-3">
                <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sapsSidebar" aria-controls="sapsSidebar">
                    <i class="bi bi-list"></i>
                </button>
                <span class="navbar-brand mb-0 h6 d-lg-none text-truncate">@ViewData["Title"]</span>

                <div class="ms-auto d-flex align-items-center gap-1">
                    <a class="btn btn-danger btn-sm fw-bold me-1" asp-controller="Emergency" asp-action="Index" title="Emergency">
                        <i class="bi bi-exclamation-triangle-fill"></i> <span class="d-none d-sm-inline">Emergency</span>
                    </a>

                    <button type="button" class="btn saps-topbar-icon-btn" data-theme-toggle aria-label="Toggle light/dark theme">
                        <i class="bi bi-sun"></i>
                    </button>

                    <div class="dropdown">
                        <button class="btn saps-topbar-icon-btn position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-bell fs-5"></i>
                            @if (unreadNotificationCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger">@unreadNotificationCount</span>
                            }
                        </button>
                        <div class="dropdown-menu dropdown-menu-end saps-notif-menu shadow-sm">
                            <h6 class="dropdown-header">Notifications</h6>
                            @if (!recentNotifications.Any())
                            {
                                <div class="dropdown-item-text text-muted small py-3 text-center">You're all caught up.</div>
                            }
                            else
                            {
                                foreach (var notification in recentNotifications)
                                {
                                    <a class="dropdown-item saps-notif-item @(notification.ReadStatus ? "" : "unread")" asp-controller="NotificationsPage" asp-action="Index">
                                        <div class="small text-truncate">@notification.Message</div>
                                        <div class="text-muted" style="font-size:.75rem;">@notification.SentDate.ToLocalTime().ToString("dd MMM, HH:mm")</div>
                                    </a>
                                }
                            }
                            <hr class="dropdown-divider" />
                            <a class="dropdown-item text-center small fw-semibold" asp-controller="NotificationsPage" asp-action="Index">View all notifications</a>
                        </div>
                    </div>

                    <div class="vr mx-2 d-none d-sm-block" style="height: 1.5rem;"></div>

                    <div class="dropdown">
                        <button class="btn saps-topbar-icon-btn d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="saps-avatar-sm">@initials</div>
                            <span class="d-none d-md-inline small fw-semibold">@User.GetFullName()</span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><h6 class="dropdown-header">@User.GetFullName()</h6></li>
                            <li><span class="dropdown-item-text text-muted small">@User.GetRoleName()</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-badge"></i> My Profile</a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <div class="p-3 p-lg-4">
                @{
                    var flashSuccess = TempData["SuccessMessage"] as string;
                    var flashError = TempData["ErrorMessage"] as string;
                }
                @if (flashSuccess != null || flashError != null)
                {
                    <script>
                        window.sapsFlash = {
                            success: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(flashSuccess)),
                            error: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(flashError))
                        };
                    </script>
                }
                @if (requiresEmailVerification)
                {
                    IgnoreBody();
                    <div class="d-flex justify-content-center">
                        <div class="card saps-card text-center" style="max-width: 480px; border: 2px solid #d9a441;">
                            <div class="p-4">
                                <i class="bi bi-envelope-exclamation-fill text-warning" style="font-size: 3rem;"></i>
                                <h2 class="h4 mt-3 mb-2">Verify Your Email</h2>
                                <p class="mb-2">
                                    Your email address has not been verified yet. Please check your inbox for the
                                    verification link we sent when you registered.
                                </p>
                                <p class="text-muted small mb-4">
                                    You'll be able to see your dashboard and use the rest of the site once your
                                    email is verified.
                                </p>
                                <form asp-controller="Account" asp-action="ResendVerificationEmail" method="post">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Resend Verification Email</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @RenderBody()
                }
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
