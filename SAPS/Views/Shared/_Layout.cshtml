<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        // Set before any CSS paints, so there's no flash of the wrong theme.
        (function () {
            var saved = null;
            try { saved = localStorage.getItem('saps-theme'); } catch (e) { /* private browsing, etc. */ }
            document.documentElement.setAttribute('data-bs-theme', saved === 'light' ? 'light' : 'dark');
        })();
    </script>
    <title>@ViewData["Title"] - SAPS Crime Pre-Reporting</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SAPS.styles.css" asp-append-version="true" />
</head>
<body>
    @await Html.PartialAsync("_GlobalSpinner")
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark saps-navbar mb-3">
            <div class="container-fluid saps-navbar-inner">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/branding/saps-logo.png" alt="SAPS" class="saps-navbar-logo" />
                    SAPS Crime Pre-Reporting
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Faq">FAQ</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="NotificationsPage" asp-action="Index">Notifications</a>
                            </li>
                            @switch (User.GetRoleName())
                            {
                                case "Complainant":
                                    <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Submit">Submit Report</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Mine">My Reports</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Dockets" asp-action="Mine">My Dockets</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Escalations" asp-action="Mine">My Escalations</a></li>
                                    break;
                                case "SapsOfficer":
                                    <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="ForReview">Reports For Review</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Dockets" asp-action="Station">Dockets At My Station</a></li>
                                    break;
                                case "StationCommander":
                                    <li class="nav-item"><a class="nav-link" asp-controller="Dockets" asp-action="Station">Dockets At My Station</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="Escalations" asp-action="Station">Escalations At My Station</a></li>
                                    break;
                                case "SystemAdministrator":
                                    <li class="nav-item"><a class="nav-link" asp-controller="AdminUsers" asp-action="Index">Users</a></li>
                                    <li class="nav-item"><a class="nav-link" asp-controller="AdminStations" asp-action="Index">Stations</a></li>
                                    break;
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item me-lg-2">
                            <a class="btn btn-danger btn-sm fw-bold" asp-controller="Emergency" asp-action="Index" title="Emergency">
                                <i class="bi bi-exclamation-triangle-fill"></i> Emergency
                            </a>
                        </li>
                        <li class="nav-item me-lg-2">
                            <button type="button" class="btn saps-topbar-icon-btn" data-theme-toggle aria-label="Toggle light/dark theme">
                                <i class="bi bi-sun"></i>
                            </button>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="nav-link">@User.GetFullName() (@User.GetRoleName())</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link nav-link">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @{
                var flashSuccess = TempData["SuccessMessage"] as string;
                var flashError = TempData["ErrorMessage"] as string;
            }
            @if (flashSuccess != null || flashError != null)
            {
                <script>
                    window.sapsFlash = {
                        success: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(flashSuccess)),
                        error: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(flashError))
                    };
                </script>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="saps-footer footer py-4 mt-5">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 SAPS Crime Pre-Reporting System. All rights reserved.</span>
            <div class="d-flex gap-3">
                <a asp-area="" asp-controller="Home" asp-action="About">About</a>
                <a asp-area="" asp-controller="Home" asp-action="Faq">FAQ</a>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
