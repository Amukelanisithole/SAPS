@model Logic.Model.Auth.ForgotPasswordRequest
@{
    ViewData["Title"] = "Forgot Password";
    var submitted = ViewBag.Submitted == true;
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card saps-card p-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-key" style="font-size: 2.5rem; color: var(--saps-accent);"></i>
                    <h1 class="h3 mt-2">Forgot Password</h1>
                    <p class="text-muted">Enter the email address on your account and we'll send you a link to reset your password.</p>
                </div>

                @if (submitted)
                {
                    <div class="alert alert-success">
                        If an account with that email exists, a password reset link has been sent to it. The link expires in 1 hour.
                    </div>
                    <p class="mt-3 text-center">
                        <a asp-controller="Account" asp-action="Login">Back to Log In</a>
                    </p>
                }
                else
                {
                    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                            <div class="saps-field-group">
                                <i class="bi bi-envelope"></i>
                                <input asp-for="Email" autocomplete="username" placeholder="name@saps.gov.za" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-send"></i> Send Reset Link</button>
                    </form>
                    <p class="mt-3 text-center">
                        <a asp-controller="Account" asp-action="Login">Back to Log In</a>
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
