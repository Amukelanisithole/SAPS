@model Logic.Model.Auth.ResetPasswordRequest
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card saps-card p-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock" style="font-size: 2.5rem; color: var(--saps-accent);"></i>
                    <h1 class="h3 mt-2">Reset Password</h1>
                    <p class="text-muted">Choose a new password for your account.</p>
                </div>
                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input asp-for="Email" type="hidden" />
                    <input asp-for="Token" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-semibold text-muted"></label>
                        <div class="saps-field-group">
                            <i class="bi bi-lock"></i>
                            <input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="New password" data-strength-meter />
                            <button type="button" class="saps-toggle-password" data-target="NewPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-muted"></label>
                        <div class="saps-field-group">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Confirm new password" />
                            <button type="button" class="saps-toggle-password" data-target="ConfirmPassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-lg"></i> Reset Password</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
