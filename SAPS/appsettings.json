{
  "App": {
    "BaseUrl": "https://localhost:7073"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SAPS;Trusted_Connection=True;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "SAPS",
    "Audience": "SAPS",
    "ExpirationInMinutes": 60
  },
  "SeedAdmin": {
    "FullName": "System Administrator",
    "IdNumber": "0000000000000",
    "Email": "admin@saps.local",
    "Password": "",
    "PhoneNumber": "0000000000"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/saps-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Smtp": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@saps.local",
    "FromName": "SAPS Crime Pre-Reporting"
  },
  "Sms": {
    "AccountSid": "",
    "AuthToken": "",
    "FromNumber": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
